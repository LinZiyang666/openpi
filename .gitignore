# factor_explorer.py emits a self-contained HTML with embedded factor data;
# the generated HTML + videos symlink are reproducible from the script and
# the cache_artifacts pkl, so we do not track them.
exp/common/analysis/factor_explorer.html
exp/common/analysis/index.html
exp/common/analysis/videos

# Guard (WA §5): logs/ holds design/decision records only, never experiment
# binaries. Experiment data/artifacts live under exp/**/data/ (ignored above).
# This catch-all (placed after the `!logs/**` un-ignore) keeps stray binary
# dumps out of logs/ by accident.
logs/**/*.pkl

# Personal skill drafts authored on this machine. The authoritative copy
# lives at ~/.claude/skills/<name>/SKILL.md and gets loaded by Claude Code
# from there; the local copy here is a working scratch and not project code.
docs/skills/

# ICLR paper workdir (Overleaf git working copy + drafts, not project deliverables)
docs/iclr/

# Generated outputs and scratch (added 2026-09-28)
# Scope: exp/offline_search/rounds/** only (other experiment lines are unaffected).
# These patterns are extension/name-based, never *.py / *.sh / *.md / *.diff / *.toml,
# so source and analysis write-ups under the same trees stay visible.
exp/offline_search/rounds/**/*.csv
exp/offline_search/rounds/**/*.jsonl
exp/offline_search/rounds/**/*.txt
exp/offline_search/rounds/**/*.png
exp/offline_search/rounds/**/*.pdf
exp/offline_search/rounds/**/*.svg
exp/offline_search/rounds/**/*.sha256
exp/offline_search/rounds/**/*.meta
exp/offline_search/rounds/**/*.stdout
exp/offline_search/rounds/**/*.tar
exp/offline_search/rounds/**/*.pid
exp/offline_search/rounds/**/*.DONE

# Packaged client deployment bundles (built by build_client_bundle.py): the
# payload/*.py copies inside are duplicated snapshots for the tarball, not
# source-of-truth (the real sources live at the round's top level, tracked).
exp/offline_search/rounds/**/client_bundle*/

# Bundled cache-library blobs and copied CLI binaries inside verification
# result trees (extensionless artifacts, not source).
exp/offline_search/rounds/**/verify_work/library/
exp/offline_search/rounds/**/verify/selftest/library/
exp/offline_search/rounds/**/launcher/bin/

# offline_search R4/R5 development snapshots, regression copies and old result launchers (never committed on purpose)
exp/offline_search/rounds/r0[45]/**/dev/
exp/offline_search/rounds/r0[45]/**/before/
exp/offline_search/rounds/r0[45]/**/baseline/
exp/offline_search/rounds/r0[45]/**/regression/
exp/offline_search/rounds/r0[45]/**/final_regression/
exp/offline_search/rounds/r0[45]/**/q2checks/
exp/offline_search/rounds/r0[45]/**/final_q2checks/
exp/offline_search/rounds/r0[45]/**/results/
# R6 smoke-analysis outputs of the ideation agents
exp/offline_search/rounds/r06/ideation_Q*/smoke_analysis*/
exp/offline_search/rounds/r06/ideation_Q*/pilot_s*/
exp/offline_search/rounds/r05/q5_gpu/boot/
exp/offline_search/rounds/r05/q3_callvalue/rerun/
# figure / plot scripts are never committed (owner rule)
exp/offline_search/rounds/**/plot.py
exp/offline_search/rounds/**/plot_*.py
