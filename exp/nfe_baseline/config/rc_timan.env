# NFE baseline x RoboCasa365: sim-worker island on timan107 / timan108 (same
# paths on both), consumed by run_ws_search.py --env-config. Copy of
# exp/robocasa365/config/collect_calib_timan107.env with REPO_ROOT pointed at
# the HEAD tree this line unpacks under /scratch/zixuans8/nfe. The server
# lists are the driver's per-teacher endpoint groups: --server must be a member
# (affinity gate), so every port a teacher may be served on is listed.
PI05_SERVERS=ziyanglin.com:23170,ziyanglin.com:23171,149.165.153.233:23231,149.165.153.233:23232
GROOT_TP_SERVERS=149.165.153.233:23230,149.165.153.233:23233,ziyanglin.com:23160,ziyanglin.com:23161

WORKER_PYTHON=/scratch/zixuans8/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/scratch/zixuans8/Isaac-GR00T/external_dependencies/robocasa365
REPO_ROOT=/scratch/zixuans8/nfe/openpi_nfe

EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
