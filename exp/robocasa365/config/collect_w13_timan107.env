# W13 re-collection (schedule-stamped warm-start corpus, collect_schema v2).
#
# Topology: teacher servers live on weilandserver ONLY, behind its public 1:1
# range (ziyanglin.com:23100-23199); the conductor driver and every sim worker
# run here on timan107. GR00T runs six servers <-> six workers, pi0.5 four <->
# four, one connection per server (the HDF5 collector is single-connection).
# The two teachers never run at the same time on the single 48 GiB card.
PI05_SERVERS=ziyanglin.com:23110,ziyanglin.com:23111,ziyanglin.com:23112,ziyanglin.com:23113,ziyanglin.com:23114,ziyanglin.com:23115
GROOT_TP_SERVERS=ziyanglin.com:23120,ziyanglin.com:23121,ziyanglin.com:23122,ziyanglin.com:23123,ziyanglin.com:23124,ziyanglin.com:23125

# Island A (sim) worker interpreter + working directory (robocasa resolves its
# assets relative to cwd).
WORKER_PYTHON=/scratch/zixuans8/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/scratch/zixuans8/Isaac-GR00T/external_dependencies/robocasa365

# The clean clone for this line. /scratch/zixuans8/openpi belongs to the
# rl_router line and must not be touched.
REPO_ROOT=/scratch/zixuans8/openpi_rc365

# timan107 has native EGL (system glvnd): no LD_LIBRARY_PATH override, vendor
# dir passed explicitly because robocasa_spawn_fn always exports it.
EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
