# weilandserver-side worker agent for the ws_search cross-machine pool
# (owner directive 2026-08-22: sim workers on BOTH timan107 and weilandserver).
# Consumed by run_ws_search.py --role agent on weilandserver.
#
# server_key must be byte-identical to what the driver dispatches under, so
# the endpoint group lists the PUBLIC names even though these workers reach
# the servers via NAT hairpin on the same host (verified working in the T7
# concurrency probes).
PI05_SERVERS=ziyanglin.com:23170,ziyanglin.com:23171,ziyanglin.com:23172,ziyanglin.com:23173,ziyanglin.com:23174,ziyanglin.com:23175
GROOT_TP_SERVERS=ziyanglin.com:23160,ziyanglin.com:23161,ziyanglin.com:23162,ziyanglin.com:23163,ziyanglin.com:23164,ziyanglin.com:23165

# Island A on weilandserver (the T5 collection worker island).
WORKER_PYTHON=/home/weiland/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/home/weiland/Isaac-GR00T/external_dependencies/robocasa365
REPO_ROOT=/home/weiland/openpi

# This host has no system EGL; both are mandatory for MUJOCO_GL=egl.
EGL_LIB_DIR=/home/weiland/nvidia-gl/root/usr/lib/x86_64-linux-gnu
EGL_VENDOR_DIR=/home/weiland/nvidia-gl/root/usr/share/glvnd/egl_vendor.d
