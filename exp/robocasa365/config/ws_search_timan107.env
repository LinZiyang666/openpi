# Deployment parameters for the RoboCasa365 weighted-sum search (T7 round 1).
# Consumed by run_ws_search.py --env-config on timan107; code carries NO
# absolute paths.
#
# Topology: cache servers live on weilandserver behind the public 1:1 range
# (ziyanglin.com:23100-23199); the conductor driver + sim workers run on
# timan107 (--role all equivalent, single process). Slot ports are per-teacher
# disjoint so the affinity gate can tell the groups apart:
#   GR00T slots 23160-23165, pi05 slots 23170-23175.
PI05_SERVERS=ziyanglin.com:23170,ziyanglin.com:23171,ziyanglin.com:23172,ziyanglin.com:23173,ziyanglin.com:23174,ziyanglin.com:23175
GROOT_TP_SERVERS=ziyanglin.com:23160,ziyanglin.com:23161,ziyanglin.com:23162,ziyanglin.com:23163,ziyanglin.com:23164,ziyanglin.com:23165

# Island A (sim) worker interpreter + working directory (robocasa resolves its
# assets relative to cwd). timan107 sim island, deployed 2026-08-21.
WORKER_PYTHON=/scratch/zixuans8/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/scratch/zixuans8/Isaac-GR00T/external_dependencies/robocasa365

# Repo checkout the workers import openpi.conductor / exp.robocasa365 from
# (the clean shallow clone; the shared /scratch/zixuans8/openpi belongs to the
# rl_router line and must not be touched).
REPO_ROOT=/scratch/zixuans8/openpi_rc365

# timan107 has native EGL (system glvnd): no LD_LIBRARY_PATH override, vendor
# dir passed explicitly because robocasa_spawn_fn always exports it.
EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
