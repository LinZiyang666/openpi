# pi0.5 k=1 workers on weilandserver, driving the h100 server over the public
# entry point. Rendering goes through the 4090's own EGL stack -- the
# libnvidia-gl-595-server package installed 2026-09-11 supplies
# libEGL_nvidia.so and 10_nvidia.json, without which this box silently fell
# back to llvmpipe software rasterisation (7.45 ms/frame vs 1.54) and, worse,
# produced pixels from a different renderer than every other lane in the study.
PI05_SERVERS=149.165.153.233:23200
GROOT_TP_SERVERS=ziyanglin.com:23160,ziyanglin.com:23161,ziyanglin.com:23162,ziyanglin.com:23163,ziyanglin.com:23164

WORKER_PYTHON=/home/weiland/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/home/weiland/Isaac-GR00T/external_dependencies/robocasa365
REPO_ROOT=/home/weiland/projects/openpi

EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
