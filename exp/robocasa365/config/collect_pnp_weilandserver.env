# Deployment parameters for the PINNED-OBJECT RoboCasa365 collection on
# weilandserver. Separate from collect_weilandserver.env because this round
# runs five servers per teacher -- one per PickPlace task, so the five tasks
# collect concurrently instead of queueing through a smaller pool.
#
# Per-teacher endpoint groups (frozen affinity, plan §4.3.4a): one driver
# invocation serves exactly one teacher's homogeneous endpoints.
#
# Counts are VRAM-bound on the single 48 GiB card: GR00T needs ~8.5 GiB per
# process (5 x 8.5 = 42.5), pi0.5 ~10.5 GiB (4 x 10.5 = 42). The two teachers
# therefore run one after the other, never at the same time.
PI05_SERVERS=127.0.0.1:8010,127.0.0.1:8011,127.0.0.1:8012,127.0.0.1:8013
GROOT_TP_SERVERS=127.0.0.1:8020,127.0.0.1:8021,127.0.0.1:8022,127.0.0.1:8023,127.0.0.1:8024

# Island A (sim) worker interpreter + working directory (robocasa resolves its
# assets relative to cwd).
WORKER_PYTHON=/home/weiland/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/home/weiland/Isaac-GR00T/external_dependencies/robocasa365

# Repo checkout the workers import openpi.conductor / exp.robocasa365 from.
REPO_ROOT=/home/weiland/openpi

# This host has no system EGL; both are mandatory for MUJOCO_GL=egl.
EGL_LIB_DIR=/home/weiland/nvidia-gl/root/usr/lib/x86_64-linux-gnu
EGL_VENDOR_DIR=/home/weiland/nvidia-gl/root/usr/share/glvnd/egl_vendor.d
