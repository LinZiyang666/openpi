# step-vs-warm-start x RoboCasa365: sim-worker island on timan108 (plan §3.0: RC workers on
# timan108, servers on h100). Consumed by exp.step_diag.run_diag --env-config. The server lists are
# the driver's per-teacher endpoint groups (--servers must be members); one port block per teacher
# on h100's public address, probed free at Step 0 before any launch (they are not reserved).
PI05_SERVERS=149.165.153.233:23240,149.165.153.233:23241,149.165.153.233:23242,149.165.153.233:23243,149.165.153.233:23244,149.165.153.233:23245,149.165.153.233:23246,149.165.153.233:23247
GROOT_TP_SERVERS=149.165.153.233:23250,149.165.153.233:23251,149.165.153.233:23252,149.165.153.233:23253,149.165.153.233:23254,149.165.153.233:23255,149.165.153.233:23256,149.165.153.233:23257,149.165.153.233:23258,149.165.153.233:23259

# Island A (sim) interpreter + working directory, identical on timan107 / timan108.
WORKER_PYTHON=/scratch/zixuans8/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/scratch/zixuans8/Isaac-GR00T/external_dependencies/robocasa365

# The clean tree this line unpacks on the worker box at Step 0 (never the rl_router / nfe trees).
REPO_ROOT=/scratch/zixuans8/step_diag/openpi

# Native EGL (system glvnd): no LD_LIBRARY_PATH override; the vendor dir is always exported.
EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
