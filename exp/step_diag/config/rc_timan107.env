# step-vs-warm-start x RoboCasa365, second lane: sim-worker island on timan107 driving servers on
# weilandserver (public 1:1 range ziyanglin.com:23100-23199). Consumed by exp.step_diag.run_diag
# --env-config. Added 2026-09-20 when the owner ruled that no host may sit idle: the GR00T Q-B arms
# run on this lane while the pi0.5 Q-B arms run on h100 <-> timan108 (rc_timan.env); every arm of one
# policy stays on one lane, so the comparison topology is fixed within a policy.
PI05_SERVERS=ziyanglin.com:23140,ziyanglin.com:23141,ziyanglin.com:23142,ziyanglin.com:23143,ziyanglin.com:23144,ziyanglin.com:23145,ziyanglin.com:23146,ziyanglin.com:23147
GROOT_TP_SERVERS=ziyanglin.com:23150,ziyanglin.com:23151,ziyanglin.com:23152,ziyanglin.com:23153,ziyanglin.com:23154,ziyanglin.com:23155,ziyanglin.com:23156,ziyanglin.com:23157,ziyanglin.com:23158,ziyanglin.com:23159

# Island A (sim) interpreter + working directory, identical on timan107 / timan108.
WORKER_PYTHON=/scratch/zixuans8/Isaac-GR00T/gr00t/eval/sim/robocasa365/robocasa365_uv/.venv/bin/python
ROBOCASA_CWD=/scratch/zixuans8/Isaac-GR00T/external_dependencies/robocasa365

# The clean tree this line unpacks on the worker box.
REPO_ROOT=/scratch/zixuans8/step_diag/openpi

# Native EGL (system glvnd): no LD_LIBRARY_PATH override; the vendor dir is always exported.
EGL_LIB_DIR=
EGL_VENDOR_DIR=/usr/share/glvnd/egl_vendor.d
