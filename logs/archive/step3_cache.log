### cache_storage.py — Facade

```python
# src/openpi/cache/cache_storage.py
from __future__ import annotations
import dataclasses
import threading
from typing import Optional
from openpi.cache.backend_base import VectorStoreBackend
from openpi.cache.storage_types import (
    BatchInsertResult, CacheEntry, CachePayload, QuerySpec,
    SearchResult, SearchResultLite, UnsupportedFilterError,
)


class CacheStorage:
    """存储层门面。CacheOrchestrator 唯一的存储入口。

    职责：
    - 线程安全（RLock 保护所有 backend 调用）
    - 维度校验（insert/search 时检查 query_key.shape）
    - Filter 能力检查（fail-fast，不静默忽略）
    - CacheEntry 校验（调用 entry.validate()）
    - 两段式搜索（search 返回 lite，fetch_payload 按需取完整 payload）
    - MetadataDB 预留（vector 先写，metadata 后写，vector 为 source of truth）
    """

    def __init__(self, backend: VectorStoreBackend, metadata_db=None):
        self._backend = backend
        self._metadata_db = metadata_db   # 预留，暂未使用
        self._dim = backend.vector_dim
        self._lock = threading.RLock()

    # --- 搜索（两段式）---

    def search(self, spec: QuerySpec) -> list[SearchResultLite]:
        """向量搜索，返回轻量结果（无 payload）。"""
        self._check_query_dim(spec.query_key)
        self._check_filters(spec)
        with self._lock:
            return self._backend.search(spec)

    def fetch_payload(self, id: str) -> CachePayload:
        """按 id 取完整 payload，仅对命中候选调用。"""
        with self._lock:
            return self._backend.fetch_payload(id)

    def search_and_fetch(self, spec: QuerySpec) -> list[SearchResult]:
        """便利方法：搜索后对所有 lite 结果逐一 fetch payload。
        top_k 较小时可用；top_k 较大时建议手动 search() + 筛选后再 fetch_payload()。
        """
        lites = self.search(spec)
        results = []
        for lite in lites:
            payload = self.fetch_payload(lite.id)
            results.append(SearchResult(
                id=lite.id, score=lite.score,
                payload=payload, checkpoint_id=lite.checkpoint_id,
            ))
        return results

    # --- 写入 ---

    def insert(self, entry: CacheEntry) -> None:
        self._check_entry_dim(entry)
        entry.validate()
        with self._lock:
            self._backend.insert(entry)
            # MetadataDB 写在 vector 之后；vector 为 source of truth
            # if self._metadata_db: self._metadata_db.insert(entry)

    def batch_insert(self, entries: list[CacheEntry]) -> BatchInsertResult:
        for entry in entries:
            self._check_entry_dim(entry)
            entry.validate()
        with self._lock:
            return self._backend.batch_insert(entries)

    # --- 管理 ---

    def delete(self, ids: list[str]) -> None:
        with self._lock:
            self._backend.delete(ids)

    def count(self) -> int:
        with self._lock:
            return self._backend.count()

    def close(self) -> None:
        """close() 隐式调用 flush()，两个 DB 都保证持久化。"""
        with self._lock:
            self._backend.close()   # backend.close() 内部已调用 flush()

    # --- 内部校验 ---

    def _check_query_dim(self, query_key) -> None:
        if query_key.shape != (self._dim,):
            raise ValueError(f"query_key 维度不匹配：期望 ({self._dim},)，实际 {tuple(query_key.shape)}")

    def _check_entry_dim(self, entry: CacheEntry) -> None:
        if entry.query_key.shape != (self._dim,):
            raise ValueError(f"entry.query_key 维度不匹配：期望 ({self._dim},)，实际 {tuple(entry.query_key.shape)}")

    def _check_filters(self, spec: QuerySpec) -> None:
        if spec.filters is None:
            return
        requested = {
            k for k, v in dataclasses.asdict(spec.filters).items() if v is not None
        }
        unsupported = requested - self._backend.supported_filters()
        if unsupported:
            raise UnsupportedFilterError(
                f"此 backend 不支持 filter 字段：{unsupported}。"
                f"支持的字段：{self._backend.supported_filters()}"
            )
```

