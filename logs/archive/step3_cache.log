### backend_base.py — ABC

```python
# src/openpi/cache/backend_base.py
from abc import ABC, abstractmethod
from openpi.cache.storage_types import (
    BatchInsertResult, CacheEntry, CachePayload, QuerySpec, SearchResultLite,
)


class VectorStoreBackend(ABC):
    """向量存储后端的最小公约数接口。

    契约：
    - insert() 幂等：相同 id 重复写入以最新为准，不报错
    - search() 返回 SearchResultLite（无 payload），score 为归一化 cosine similarity ∈ [-1, 1]
    - search() 返回"至多 top_k"条结果，client-side filter 后可能少于 k，调用方须能处理
    - fetch_payload() 按 id 取完整 payload
    - delete() 容忍不存在的 id
    - 实现不保证线程安全，CacheStorage 负责加锁
    """

    @property
    @abstractmethod
    def vector_dim(self) -> int:
        """此 backend 期望的向量维度，CacheStorage 用于校验输入。"""
        ...

    @abstractmethod
    def supported_filters(self) -> frozenset[str]:
        """返回此 backend 支持的 QueryFilter 字段名集合。
        不支持的字段若被请求，CacheStorage 将抛出 UnsupportedFilterError。
        """
        ...

    @abstractmethod
    def insert(self, entry: CacheEntry) -> None: ...

    @abstractmethod
    def search(self, spec: QuerySpec) -> list[SearchResultLite]: ...

    @abstractmethod
    def fetch_payload(self, id: str) -> CachePayload: ...

    @abstractmethod
    def delete(self, ids: list[str]) -> None: ...

    @abstractmethod
    def count(self) -> int: ...

    def batch_insert(self, entries: list[CacheEntry]) -> BatchInsertResult:
        """默认逐条插入，部分失败不中断。backend 可重写为原生批量 API。"""
        inserted = 0
        failed_ids = []
        for entry in entries:
            try:
                self.insert(entry)
                inserted += 1
            except Exception:
                failed_ids.append(entry.id)
        return BatchInsertResult(inserted=inserted, failed_ids=failed_ids)

    def flush(self) -> None:
        """持久化缓冲数据。内存型 backend 实现；其他默认 no-op。"""

    def close(self) -> None:
        """释放连接/资源。close() 前自动调用 flush()。"""
        self.flush()
```

