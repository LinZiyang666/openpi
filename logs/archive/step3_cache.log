### storage_types.py — 数据模型

```python
# src/openpi/cache/storage_types.py
from __future__ import annotations
import time
from dataclasses import dataclass, field
from typing import Optional
import torch
from openpi.cache.types import CheckpointID


class UnsupportedFilterError(Exception):
    """QueryFilter 包含此 backend 不支持的字段时抛出。"""


@dataclass
class CachePayload:
    """缓存条目的有效载荷。

    Tensor 契约：所有 tensor 必须是 CPU contiguous float32，调用方在构造前负责转换。
    search() 返回的 payload 同样保证 CPU float32，GPU 转移由 Orchestrator 负责。

    CP1: action_chunk 必填，其余为 None。
    CP2 full hit: action_chunk 必填，其余为 None。
    CP2 warm start: action_chunk + intermediates + denoising_num_steps 必填。
    CP3: action_chunk + next_action_chunk 必填。
    """
    action_chunk: torch.Tensor                          # [50, 32]，所有 CP 必填
    intermediates: Optional[dict[float, torch.Tensor]]  # {t: x_t}，key 与 save_timesteps 字面量对齐
    denoising_num_steps: Optional[int]                  # warm start 时必填，传给 run_stage3_from()
    next_action_chunk: Optional[torch.Tensor]           # [50, 32]，CP3 必填
    task_key: str = ""                                  # 规范化 task 标识符，非原始 prompt

    def validate_for_checkpoint(self, checkpoint_id: CheckpointID) -> None:
        if self.action_chunk is None:
            raise ValueError("action_chunk 对所有 CP 都必须非空")
        if checkpoint_id == CheckpointID.CP3 and self.next_action_chunk is None:
            raise ValueError("CP3 的 next_action_chunk 必须非空")
        if self.intermediates is not None and self.denoising_num_steps is None:
            raise ValueError("intermediates 非空时 denoising_num_steps 必须提供")


@dataclass
class CacheEntry:
    """写入存储的完整单元。

    id 语义：stable_hash(checkpoint_id.name + ":" + query_key_bytes)
    同一 context + 同一 CP 只保留一条记录（语义去重键）。
    不同 CP 的相同 query_key 不会互相覆盖，因为 checkpoint_id 参与了 hash。
    """
    id: str
    checkpoint_id: CheckpointID
    query_key: torch.Tensor     # CPU float32 [dim]，L2 归一化
    payload: CachePayload
    timestamp: float = field(default_factory=time.time)

    def validate(self) -> None:
        """校验 CP-specific 不变量。CacheStorage.insert() 自动调用，无需手动触发。"""
        self.payload.validate_for_checkpoint(self.checkpoint_id)


@dataclass
class QueryFilter:
    """每次查询不同的约束条件。

    不支持某个字段的 backend 必须在 supported_filters() 中不列出它，
    CacheStorage 会在调用 backend 前 fail-fast，而不是静默忽略。

    task_key: 规范化 task 标识符（如 "libero_spatial_pick_up_the_black_bowl"），
              调用方负责规范化，不传原始 prompt 字符串。
    step_range: 限制检索的 episode step 范围 [min, max]（含两端）。
    """
    task_key: Optional[str] = None
    step_range: Optional[tuple[int, int]] = None


@dataclass
class QuerySpec:
    query_key: torch.Tensor             # CPU float32 [dim]
    top_k: int = 10
    checkpoint_id: Optional[CheckpointID] = None
    filters: Optional[QueryFilter] = None


@dataclass
class SearchResultLite:
    """轻量搜索结果，不含大 tensor payload。

    search() 返回此类型，judge 用 score 做阈值筛选。
    只对命中候选调用 fetch_payload() 获取完整 payload，避免传输无用数据。

    score 契约：归一化 cosine similarity ∈ [-1, 1]，所有 backend 必须统一转换。
    不同 backend 的 threshold 因此可以复用。
    """
    id: str
    score: float
    checkpoint_id: CheckpointID


@dataclass
class SearchResult:
    """完整搜索结果，含 payload，由 fetch_payload() 或 search_and_fetch() 填充。"""
    id: str
    score: float
    payload: CachePayload
    checkpoint_id: CheckpointID


@dataclass
class BatchInsertResult:
    inserted: int
    failed_ids: list[str]
```

