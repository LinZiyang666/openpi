# src/openpi/cache/backends/qdrant_backend.py

@dataclass
class QdrantBackendConfig:
    url: str = "http://localhost:6333"
    collection_name: str = "openpi_cache"
    vector_dim: int = 1024
    distance: str = "Cosine"          # Qdrant distance metric
    prefer_grpc: bool = False
    timeout: int = 30


class QdrantVectorStore(VectorStoreBackend):
    def __init__(self, config: QdrantBackendConfig):
        self.config = config
        self._client = QdrantClient(url=config.url, prefer_grpc=config.prefer_grpc)
        self._ensure_collection()

    def insert(self, entry: CacheEntry) -> None:
        # CacheEntry.query_key → Qdrant vector（flat [dim]）
        # CacheEntry.payload + checkpoint_id + timestamp → Qdrant payload
        ...

    def search(self, spec: QuerySpec) -> list[SearchResult]:
        # spec.query_key → Qdrant search
        # 可选 filter：spec.checkpoint_id → Qdrant filter by payload["checkpoint_id"]
        # 返回时将 Qdrant distance 转成 similarity score（1 - distance for Cosine）
        ...
```

