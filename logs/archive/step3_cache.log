### backends/qdrant_backend.py — Qdrant 实现

```python
# src/openpi/cache/backends/qdrant_backend.py
from __future__ import annotations
import base64
import io
import logging
from dataclasses import dataclass
from typing import Optional
import torch
from qdrant_client import QdrantClient
from qdrant_client.models import (
    Filter, FieldCondition, MatchValue, Range, PointStruct,
)
from openpi.cache.backend_base import VectorStoreBackend
from openpi.cache.storage_types import (
    BatchInsertResult, CacheEntry, CachePayload, QuerySpec, SearchResultLite,
)
from openpi.cache.types import CheckpointID

logger = logging.getLogger(__name__)


@dataclass
class QdrantBackendConfig:
    url: str = "http://localhost:6333"
    collection_name: str = "openpi_cache"
    vector_dim: int = 1024
    prefer_grpc: bool = False
    request_timeout: int = 30


class QdrantVectorStore(VectorStoreBackend):
    """Qdrant 向量存储后端。

    collection 由运维人员预先创建，此类不做自动创建。
    序列化：tensor → torch.save bytes → base64 字符串，存入 Qdrant JSON payload。
    """

    _SUPPORTED_FILTERS = frozenset({"checkpoint_id", "task_key", "step_range"})

    def __init__(self, config: QdrantBackendConfig):
        self._config = config
        self._client = QdrantClient(
            url=config.url,
            prefer_grpc=config.prefer_grpc,
            timeout=config.request_timeout,
        )

    @property
    def vector_dim(self) -> int:
        return self._config.vector_dim

    def supported_filters(self) -> frozenset[str]:
        return self._SUPPORTED_FILTERS

    # --- 公开接口 ---

    def insert(self, entry: CacheEntry) -> None:
        self._client.upsert(
            collection_name=self._config.collection_name,
            points=[self._to_point(entry)],
        )

    def batch_insert(self, entries: list[CacheEntry]) -> BatchInsertResult:
        points = []
        failed_ids = []
        for entry in entries:
            try:
                points.append(self._to_point(entry))
            except Exception as e:
                logger.warning("序列化失败，跳过 entry %s：%s", entry.id, e)
                failed_ids.append(entry.id)
        if points:
            self._client.upsert(
                collection_name=self._config.collection_name,
                points=points,
            )
        return BatchInsertResult(inserted=len(points), failed_ids=failed_ids)

    def search(self, spec: QuerySpec) -> list[SearchResultLite]:
        hits = self._client.search(
            collection_name=self._config.collection_name,
            query_vector=spec.query_key.float().cpu().numpy().tolist(),
            limit=spec.top_k,
            query_filter=self._make_filter(spec),
            with_payload=False,   # 轻量搜索，不取 payload
            with_vectors=False,
        )
        return [
            SearchResultLite(
                id=str(h.id),
                score=float(h.score),   # Qdrant Cosine 已是 [-1,1]，直接用
                checkpoint_id=CheckpointID[h.payload["checkpoint_id"]] if h.payload else spec.checkpoint_id,
            )
            for h in hits
        ]

    def fetch_payload(self, id: str) -> CachePayload:
        results = self._client.retrieve(
            collection_name=self._config.collection_name,
            ids=[id],
            with_payload=True,
        )
        if not results:
            raise KeyError(f"id {id!r} 在 collection 中不存在")
        return self._deserialize_payload(results[0].payload)

    def delete(self, ids: list[str]) -> None:
        self._client.delete(
            collection_name=self._config.collection_name,
            points_selector=ids,
        )

    def count(self) -> int:
        return self._client.count(collection_name=self._config.collection_name).count

    # --- 内部序列化 ---

    def _to_point(self, entry: CacheEntry) -> PointStruct:
        return PointStruct(
            id=entry.id,
            vector=entry.query_key.float().cpu().numpy().tolist(),
            payload={
                "checkpoint_id": entry.checkpoint_id.name,
                "timestamp": entry.timestamp,
                **self._serialize_payload(entry.payload),
            },
        )

    @staticmethod
    def _serialize_payload(p: CachePayload) -> dict:
        def t2b64(t: Optional[torch.Tensor]) -> Optional[str]:
            if t is None:
                return None
            buf = io.BytesIO()
            torch.save(t, buf)
            return base64.b64encode(buf.getvalue()).decode()

        intermediates_b64 = None
        if p.intermediates:
            # key 用 f"{t:.4f}" 字符串，避免 JSON round-trip 精度问题
            intermediates_b64 = {f"{k:.4f}": t2b64(v) for k, v in p.intermediates.items()}

        return {
            "action_chunk": t2b64(p.action_chunk),
            "intermediates": intermediates_b64,
            "denoising_num_steps": p.denoising_num_steps,
            "next_action_chunk": t2b64(p.next_action_chunk),
            "task_key": p.task_key,
        }

    @staticmethod
    def _deserialize_payload(p: dict) -> CachePayload:
        def b642t(s: Optional[str]) -> Optional[torch.Tensor]:
            if s is None:
                return None
            buf = io.BytesIO(base64.b64decode(s))
            return torch.load(buf, weights_only=True)

        intermediates = None
        if p.get("intermediates"):
            intermediates = {float(k): b642t(v) for k, v in p["intermediates"].items()}

        return CachePayload(
            action_chunk=b642t(p["action_chunk"]),
            intermediates=intermediates,
            denoising_num_steps=p.get("denoising_num_steps"),
            next_action_chunk=b642t(p.get("next_action_chunk")),
            task_key=p.get("task_key", ""),
        )

    @staticmethod
    def _make_filter(spec: QuerySpec) -> Optional[Filter]:
        conditions = []
        if spec.checkpoint_id is not None:
            conditions.append(
                FieldCondition(key="checkpoint_id", match=MatchValue(value=spec.checkpoint_id.name))
            )
        if spec.filters:
            if spec.filters.task_key is not None:
                conditions.append(
                    FieldCondition(key="task_key", match=MatchValue(value=spec.filters.task_key))
                )
            if spec.filters.step_range is not None:
                lo, hi = spec.filters.step_range
                conditions.append(
                    FieldCondition(key="step_idx", range=Range(gte=lo, lte=hi))
                )
        return Filter(must=conditions) if conditions else None
```

