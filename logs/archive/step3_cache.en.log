## VectorStoreBackend ABC

```python
# src/openpi/cache/backend_base.py

from abc import ABC, abstractmethod
from openpi.cache.storage_types import CacheEntry, QuerySpec, SearchResult


class VectorStoreBackend(ABC):
    """Least-common-denominator interface for vector store backends.

    Implementors must guarantee:
    - insert() is idempotent (repeated insert with the same id doesn't error, latest wins)
    - search() returns scores with unified semantics: higher = more similar (if internally distance, must convert)
    - delete() doesn't error on non-existent ids
    """

    @abstractmethod
    def insert(self, entry: CacheEntry) -> None:
        """Write a cache entry."""
        ...

    @abstractmethod
    def search(self, spec: QuerySpec) -> list[SearchResult]:
        """Vector nearest-neighbor search, returns top-k results."""
        ...

    @abstractmethod
    def delete(self, ids: list[str]) -> None:
        """Delete entries by ID (for eviction)."""
        ...

    @abstractmethod
    def count(self) -> int:
        """Number of currently stored entries."""
        ...

    # --- Optional extensions (not abstract, have default implementations) ---

    def batch_insert(self, entries: list[CacheEntry]) -> None:
        """Batch write. Defaults to per-entry insert; backends can override for better efficiency."""
        for e in entries:
            self.insert(e)

    def flush(self) -> None:
        """Flush un-persisted data (meaningful for in-memory backends). Default no-op."""
        pass

    def close(self) -> None:
        """Release connections/resources. Default no-op."""
        pass
```

The interface is intentionally small. **Does not expose** collection name, named vector, multivector, filter syntax, etc. — all of these are handled in each backend's `__init__` config.

