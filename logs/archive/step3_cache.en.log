### storage_types.py — Data Models

```python
# src/openpi/cache/storage_types.py
from __future__ import annotations
import time
from dataclasses import dataclass, field
from typing import Optional
import torch
from openpi.cache.types import CheckpointID


class UnsupportedFilterError(Exception):
    """Raised when QueryFilter contains fields unsupported by this backend."""


@dataclass
class CachePayload:
    """Payload of a cache entry.

    Tensor contract: All tensors must be CPU contiguous float32; the caller is responsible
    for conversion before construction. Payloads returned by search() also guarantee
    CPU float32; GPU transfer is the Orchestrator's responsibility.

    CP1: action_chunk required, others are None.
    CP2 full hit: action_chunk required, others are None.
    CP2 warm start: action_chunk + intermediates + denoising_num_steps required.
    CP3: action_chunk + next_action_chunk required.
    """
    action_chunk: torch.Tensor                          # [50, 32], required for all CPs
    intermediates: Optional[dict[float, torch.Tensor]]  # {t: x_t}, keys aligned with save_timesteps literals
    denoising_num_steps: Optional[int]                  # Required for warm start, passed to run_stage3_from()
    next_action_chunk: Optional[torch.Tensor]           # [50, 32], required for CP3
    task_key: str = ""                                  # Normalized task identifier, not raw prompt

    def validate_for_checkpoint(self, checkpoint_id: CheckpointID) -> None:
        if self.action_chunk is None:
            raise ValueError("action_chunk must be non-None for all CPs")
        if checkpoint_id == CheckpointID.CP3 and self.next_action_chunk is None:
            raise ValueError("next_action_chunk must be non-None for CP3")
        if self.intermediates is not None and self.denoising_num_steps is None:
            raise ValueError("denoising_num_steps must be provided when intermediates is non-None")


@dataclass
class CacheEntry:
    """Complete unit written to storage.

    id semantics: stable_hash(checkpoint_id.name + ":" + query_key_bytes)
    Only one record is kept for the same context + same CP (semantic dedup key).
    Different CPs with the same query_key won't overwrite each other because checkpoint_id is part of the hash.
    """
    id: str
    checkpoint_id: CheckpointID
    query_key: torch.Tensor     # CPU float32 [dim], L2-normalized
    payload: CachePayload
    timestamp: float = field(default_factory=time.time)

    def validate(self) -> None:
        """Validate CP-specific invariants. Automatically called by CacheStorage.insert(); no manual trigger needed."""
        self.payload.validate_for_checkpoint(self.checkpoint_id)


@dataclass
class QueryFilter:
    """Per-query constraints that vary with each query.

    Backends that don't support a given field must not list it in supported_filters();
    CacheStorage will fail-fast before calling the backend, rather than silently ignoring.

    task_key: Normalized task identifier (e.g., "libero_spatial_pick_up_the_black_bowl");
              caller is responsible for normalization, do not pass raw prompt strings.
    step_range: Restrict retrieval to episode step range [min, max] (inclusive on both ends).
    """
    task_key: Optional[str] = None
    step_range: Optional[tuple[int, int]] = None


@dataclass
class QuerySpec:
    query_key: torch.Tensor             # CPU float32 [dim]
    top_k: int = 10
    checkpoint_id: Optional[CheckpointID] = None
    filters: Optional[QueryFilter] = None


@dataclass
class SearchResultLite:
    """Lightweight search result without large tensor payload.

    search() returns this type; judge uses score for threshold filtering.
    Only call fetch_payload() for hit candidates to get full payload, avoiding transfer of unnecessary data.

    Score contract: normalized cosine similarity in [-1, 1]; all backends must convert uniformly.
    Thresholds can therefore be reused across backends.
    """
    id: str
    score: float
    checkpoint_id: CheckpointID


@dataclass
class SearchResult:
    """Full search result with payload, populated by fetch_payload() or search_and_fetch()."""
    id: str
    score: float
    payload: CachePayload
    checkpoint_id: CheckpointID


@dataclass
class BatchInsertResult:
    inserted: int
    failed_ids: list[str]
```

