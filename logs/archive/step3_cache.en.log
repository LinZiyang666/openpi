## Revised Core Data Models

```python
# types.py
from enum import Enum, auto

class CheckpointID(Enum):
    CP1 = auto()
    CP2 = auto()
    CP3 = auto()


# storage_types.py
@dataclass
class CachePayload:
    action_chunk: torch.Tensor                         # CPU float32 [50,32], required for all CPs
    intermediates: Optional[dict[float, torch.Tensor]] # Aligned with model API, key = float timestep
    denoising_num_steps: Optional[int]                 # Warm start must match value at cache time, used with intermediates
    next_action_chunk: Optional[torch.Tensor]          # Required for CP3
    task_key: str = ""                                 # Normalized task identifier, not raw prompt

    def validate_for_checkpoint(self, checkpoint_id: "CheckpointID") -> None:
        if self.action_chunk is None:
            raise ValueError("action_chunk must be non-None")
        if checkpoint_id == CheckpointID.CP3 and self.next_action_chunk is None:
            raise ValueError("next_action_chunk must be non-None for CP3")


@dataclass
class CacheEntry:
    id: str                   # hash(checkpoint_id + query_key_bytes), semantic dedup key, includes checkpoint_id (#3)
    checkpoint_id: CheckpointID
    query_key: torch.Tensor   # CPU float32 [dim], L2-normalized
    payload: CachePayload
    timestamp: float = field(default_factory=time.time)

    def validate(self) -> None:
        self.payload.validate_for_checkpoint(self.checkpoint_id)


@dataclass
class QueryFilter:
    task_key: Optional[str] = None              # Normalized task identifier, not raw prompt (#10)
    step_range: Optional[tuple[int, int]] = None


@dataclass
class QuerySpec:
    query_key: torch.Tensor        # CPU float32
    top_k: int = 10
    checkpoint_id: Optional[CheckpointID] = None
    filters: Optional[QueryFilter] = None


@dataclass
class SearchResultLite:
    """Lightweight search result without large tensor payload, used for judge candidate filtering."""
    id: str
    score: float               # Normalized cosine similarity in [-1, 1]
    checkpoint_id: CheckpointID


@dataclass
class SearchResult:
    """Full search result with payload, populated by fetch_payload()."""
    id: str
    score: float
    payload: CachePayload
    checkpoint_id: CheckpointID


@dataclass
class BatchInsertResult:
    inserted: int
    failed_ids: list[str]
```

