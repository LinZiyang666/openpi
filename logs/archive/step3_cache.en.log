### cache_storage.py — Facade

```python
# src/openpi/cache/cache_storage.py
from __future__ import annotations
import dataclasses
import threading
from typing import Optional
from openpi.cache.backend_base import VectorStoreBackend
from openpi.cache.storage_types import (
    BatchInsertResult, CacheEntry, CachePayload, QuerySpec,
    SearchResult, SearchResultLite, UnsupportedFilterError,
)


class CacheStorage:
    """Storage layer facade. The sole storage entry point for CacheOrchestrator.

    Responsibilities:
    - Thread safety (RLock protects all backend calls)
    - Dimension validation (checks query_key.shape on insert/search)
    - Filter capability checking (fail-fast, no silent ignoring)
    - CacheEntry validation (calls entry.validate())
    - Two-phase search (search returns lite, fetch_payload retrieves full payload on demand)
    - MetadataDB reserved (vector written first, metadata second, vector is source of truth)
    """

    def __init__(self, backend: VectorStoreBackend, metadata_db=None):
        self._backend = backend
        self._metadata_db = metadata_db   # Reserved, not yet used
        self._dim = backend.vector_dim
        self._lock = threading.RLock()

    # --- Search (two-phase) ---

    def search(self, spec: QuerySpec) -> list[SearchResultLite]:
        """Vector search, returns lightweight results (no payload)."""
        self._check_query_dim(spec.query_key)
        self._check_filters(spec)
        with self._lock:
            return self._backend.search(spec)

    def fetch_payload(self, id: str) -> CachePayload:
        """Retrieve full payload by id; only called for hit candidates."""
        with self._lock:
            return self._backend.fetch_payload(id)

    def search_and_fetch(self, spec: QuerySpec) -> list[SearchResult]:
        """Convenience method: search then fetch payload for all lite results.
        Usable when top_k is small; for large top_k, prefer manual search() + filter then fetch_payload().
        """
        lites = self.search(spec)
        results = []
        for lite in lites:
            payload = self.fetch_payload(lite.id)
            results.append(SearchResult(
                id=lite.id, score=lite.score,
                payload=payload, checkpoint_id=lite.checkpoint_id,
            ))
        return results

    # --- Write ---

    def insert(self, entry: CacheEntry) -> None:
        self._check_entry_dim(entry)
        entry.validate()
        with self._lock:
            self._backend.insert(entry)
            # MetadataDB write comes after vector; vector is source of truth
            # if self._metadata_db: self._metadata_db.insert(entry)

    def batch_insert(self, entries: list[CacheEntry]) -> BatchInsertResult:
        for entry in entries:
            self._check_entry_dim(entry)
            entry.validate()
        with self._lock:
            return self._backend.batch_insert(entries)

    # --- Management ---

    def delete(self, ids: list[str]) -> None:
        with self._lock:
            self._backend.delete(ids)

    def count(self) -> int:
        with self._lock:
            return self._backend.count()

    def close(self) -> None:
        """close() implicitly calls flush(), ensuring both DBs are persisted."""
        with self._lock:
            self._backend.close()   # backend.close() internally already calls flush()

    # --- Internal validation ---

    def _check_query_dim(self, query_key) -> None:
        if query_key.shape != (self._dim,):
            raise ValueError(f"query_key dimension mismatch: expected ({self._dim},), got {tuple(query_key.shape)}")

    def _check_entry_dim(self, entry: CacheEntry) -> None:
        if entry.query_key.shape != (self._dim,):
            raise ValueError(f"entry.query_key dimension mismatch: expected ({self._dim},), got {tuple(entry.query_key.shape)}")

    def _check_filters(self, spec: QuerySpec) -> None:
        if spec.filters is None:
            return
        requested = {
            k for k, v in dataclasses.asdict(spec.filters).items() if v is not None
        }
        unsupported = requested - self._backend.supported_filters()
        if unsupported:
            raise UnsupportedFilterError(
                f"This backend does not support filter fields: {unsupported}. "
                f"Supported fields: {self._backend.supported_filters()}"
            )
```

