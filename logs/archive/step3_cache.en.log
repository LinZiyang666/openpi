### backend_base.py — ABC

```python
# src/openpi/cache/backend_base.py
from abc import ABC, abstractmethod
from openpi.cache.storage_types import (
    BatchInsertResult, CacheEntry, CachePayload, QuerySpec, SearchResultLite,
)


class VectorStoreBackend(ABC):
    """Least-common-denominator interface for vector store backends.

    Contract:
    - insert() is idempotent: repeated writes with the same id use the latest, no error
    - search() returns SearchResultLite (no payload), score is normalized cosine similarity in [-1, 1]
    - search() returns "at most top_k" results; client-side filter may yield fewer than k, caller must handle this
    - fetch_payload() retrieves full payload by id
    - delete() tolerates non-existent ids
    - Implementations do not guarantee thread safety; CacheStorage is responsible for locking
    """

    @property
    @abstractmethod
    def vector_dim(self) -> int:
        """The vector dimension this backend expects; CacheStorage uses it for input validation."""
        ...

    @abstractmethod
    def supported_filters(self) -> frozenset[str]:
        """Return the set of QueryFilter field names this backend supports.
        If an unsupported field is requested, CacheStorage will raise UnsupportedFilterError.
        """
        ...

    @abstractmethod
    def insert(self, entry: CacheEntry) -> None: ...

    @abstractmethod
    def search(self, spec: QuerySpec) -> list[SearchResultLite]: ...

    @abstractmethod
    def fetch_payload(self, id: str) -> CachePayload: ...

    @abstractmethod
    def delete(self, ids: list[str]) -> None: ...

    @abstractmethod
    def count(self) -> int: ...

    def batch_insert(self, entries: list[CacheEntry]) -> BatchInsertResult:
        """Default per-entry insert; partial failures don't halt. Backend can override with native batch API."""
        inserted = 0
        failed_ids = []
        for entry in entries:
            try:
                self.insert(entry)
                inserted += 1
            except Exception:
                failed_ids.append(entry.id)
        return BatchInsertResult(inserted=inserted, failed_ids=failed_ids)

    def flush(self) -> None:
        """Persist buffered data. Relevant for in-memory backends; default no-op for others."""

    def close(self) -> None:
        """Release connections/resources. Automatically calls flush() before close()."""
        self.flush()
```

